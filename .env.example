# Copie este archivo como .env.local y ajuste lo que necesite.

# Título del sistema (como [main] titulo de contawin.ini)
CONTAWIN_TITULO=Sistema de Contabilidad

# Base de datos SQLite. Por defecto, la MISMA de ContaWinPy: ../datos/contawin.db
# CONTAWIN_DB=../datos/contawin.db

# Carpeta CONTAWIN con los DBF del sistema antiguo (sugerencia en Útiles > Importar)
# CONTAWIN_DBF=D:/Respaldar 24-01-2023/d Disco C/CONTAWIN

# Clave para firmar la sesión (mínimo 32 caracteres). Si no se indica, se genera una
# aleatoria y se guarda en datos/.contawin_secret la primera vez.
# CONTAWIN_SECRET=

# Solo si se publica detrás de HTTPS: marca la cookie de sesión como «Secure».
# CONTAWIN_COOKIE_SEGURA=1

# Solo en desarrollo (npm run dev): otras IP de la red desde donde se abre el sistema, separadas por coma
# CONTAWIN_DEV_ORIGINS=192.168.1.50,192.168.1.60
